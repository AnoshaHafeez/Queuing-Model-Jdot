<UserControl x:Class="JSimulator.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:JSimulator.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Personalize how results are displayed and exported." Style="{StaticResource PageSubtitleText}" />

            <Border Style="{StaticResource CardBorder}" Margin="0,24,0,16">
                <StackPanel>
                    <TextBlock Text="Display" Style="{StaticResource CardTitleText}" />

                    <TextBlock Text="DECIMAL PRECISION" Style="{StaticResource FieldLabelText}" Margin="0,10,0,0" />
                    <TextBlock Text="Number of decimal places shown for L, Lq, W and Wq on the Calculator tab."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8" />
                    <ComboBox Style="{StaticResource InputComboBox}"
                              ItemsSource="{Binding DecimalPlaceOptions}"
                              SelectedItem="{Binding DecimalPlaces}"
                              HorizontalAlignment="Left"
                              Width="140" />

                    <TextBlock Text="TIME UNIT LABEL" Style="{StaticResource FieldLabelText}" Margin="0,20,0,0" />
                    <TextBlock Text="Shown next to W and Wq so results read e.g. &quot;Wait time in queue (Wq) · minutes&quot;."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8" />
                    <ComboBox Style="{StaticResource InputComboBox}"
                              ItemsSource="{Binding TimeUnitOptions}"
                              SelectedItem="{Binding TimeUnitLabel}"
                              HorizontalAlignment="Left"
                              Width="180" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource CardTitleText}" />

                    <TextBlock Text="BACKGROUND" Style="{StaticResource FieldLabelText}" Margin="0,10,0,0" />

                    <RadioButton Content="Bubbles" GroupName="BackgroundStyle"
                                 IsChecked="{Binding BackgroundStyle, Converter={StaticResource StringEquals}, ConverterParameter=Bubbles}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="14" Margin="0,10,0,0" />
                    <TextBlock Text="Soft, glowing bubbles drifting upward."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,2,0,0" />

                    <RadioButton Content="3D network" GroupName="BackgroundStyle"
                                 IsChecked="{Binding BackgroundStyle, Converter={StaticResource StringEquals}, ConverterParameter=Network3D}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="14" Margin="0,12,0,0" />
                    <TextBlock Text="A slowly-rotating 3D network of glowing nodes."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,2,0,0" />

                    <RadioButton Content="None" GroupName="BackgroundStyle"
                                 IsChecked="{Binding BackgroundStyle, Converter={StaticResource StringEquals}, ConverterParameter=None}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="14" Margin="0,12,0,0" />
                    <TextBlock Text="Static background — best on lower-powered machines."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="PDF reports" Style="{StaticResource CardTitleText}" />

                    <TextBlock Text="DEFAULT EXPORT FOLDER" Style="{StaticResource FieldLabelText}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding DefaultExportFolderDisplay}"
                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,10" />
                    <Button Content="Browse…"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BrowseFolderCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Button Content="Reset to defaults"
                    Command="{Binding ResetCommand}"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="14,8"
                    Cursor="Hand" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
