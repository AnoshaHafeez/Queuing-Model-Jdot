<Window x:Class="JSimulator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JSimulator.App.ViewModels"
        xmlns:views="clr-namespace:JSimulator.App.Views"
        Title="J. Simulator" Height="840" Width="1320"
        MinHeight="640" MinWidth="1024" WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBgBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CalculatorViewModel}"><views:CalculatorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SimulationViewModel}"><views:SimulationView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComparisonViewModel}"><views:ComparisonView /></DataTemplate>
    </Window.Resources>
    <Window.DataContext><vm:MainViewModel /></Window.DataContext>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="36,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="J." Foreground="White" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="J. Simulator" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI Semibold" FontSize="18" />
                        <TextBlock Text="QUEUEING LAB" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Calculation" GroupName="MainNav" Style="{StaticResource NavButton}" IsChecked="{Binding CurrentTab, Converter={StaticResource StringEquals}, ConverterParameter=Calculator}" />
                    <RadioButton Content="Simulation" GroupName="MainNav" Style="{StaticResource NavButton}" IsChecked="{Binding CurrentTab, Converter={StaticResource StringEquals}, ConverterParameter=Simulation}" />
                    <RadioButton Content="Comparison" GroupName="MainNav" Style="{StaticResource NavButton}" IsChecked="{Binding CurrentTab, Converter={StaticResource StringEquals}, ConverterParameter=Comparison}" />
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
